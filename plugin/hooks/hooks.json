{
  "description": "web-harvester: the web is reached through Growser, so the built-in WebSearch and WebFetch are denied",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(WebSearch|WebFetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/web-gate.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
